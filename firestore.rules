rules_version = '2';

// Pass With Pannu: Firestore security rules.
//
// Model: clients READ their own data; every scheduling WRITE (bookings, requests,
// notifications) goes through Cloud Functions using the Admin SDK, which bypasses
// these rules. Admin = custom claim `admin == true`, never a field a client can set.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // ---- users --------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      match /progress/{progressId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /instructorPrivate/{documentId} {
        allow read, write: if isAdmin();
      }

      match /termsAcceptances/{acceptanceId} {
          allow read: if isOwner(uid) || isAdmin();
          allow create, update, delete: if false;
        }

        match /devices/{deviceId} {
          allow read, write: if isOwner(uid);
        }

      // Self-registration can only ever create an ACTIVE STUDENT profile.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'fullName', 'email', 'phone', 'role', 'isActive', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.isActive == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 1
        && request.resource.data.fullName.size() <= 100;

      // Students may edit only name + phone. Role/email/isActive are protected.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'updatedAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 1
        && request.resource.data.fullName.size() <= 100;

      // Admin can deactivate/reactivate a student but cannot change anyone's role from the client.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'updatedAt']);

      allow delete: if false;

      match /devices/{deviceId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---- bookings: read-only to clients ----------------------------------
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if false; // createBooking / admin* / createBookingRequest callables only
    }

    match /booking_requests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if false; // createBookingRequest / resolveBookingRequest callables only
    }

    // ---- availability blocks: admin only. Students see their effect via getAvailableSlots.
    match /availability_blocks/{blockId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'startDateTime', 'endDateTime', 'reason', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.startDateTime is timestamp
        && request.resource.data.endDateTime is timestamp
        && request.resource.data.endDateTime > request.resource.data.startDateTime;
      allow update, delete: if isAdmin();
    }

    // ---- settings: no secrets in here, students read lesson length / notice period.
    match /app_settings/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- in-app notification history -------------------------------------
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if false; // created by Cloud Functions
    }

    // ---- server-only collections ------------------------------------------
    match /travel_cache/{id} { allow read, write: if false; }
    match /schedule_days/{id} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
