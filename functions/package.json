{
  "name": "pass-with-pannu-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:rules": "firebase emulators:exec --only firestore \"jest --config jest.rules.config.js\"",
